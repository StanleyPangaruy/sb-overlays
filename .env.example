# Copy this file to .env and fill in the values, then restart the server.
PORT=3000

# Facebook Page posts -> ticker (optional)
# FB_PAGE_ID: the numeric ID of the municipality's Facebook Page
# FB_PAGE_TOKEN: a long-lived *Page* access token with pages_read_engagement
FB_PAGE_ID=
FB_PAGE_TOKEN=
FB_API_VERSION=v23.0
